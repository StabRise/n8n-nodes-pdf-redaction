{
    "name": "@stabrise/n8n-nodes-pdf-redaction",
    "version": "0.1.7",
    "description": "n8n community node for detecting and redacting PII in PDF documents via the PDF Redaction API (api.pdf-redaction.com)",
    "license": "MIT",
    "homepage": "https://pdf-redaction.com/docs/",
    "keywords": [
        "n8n-community-node-package"
    ],
    "author": {
        "name": "mykola",
        "email": "mykola.melnyk.ml@gmail.com"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/StabRise/n8n-nodes-pdf-redaction.git"
    },
    "scripts": {
        "build": "n8n-node build",
        "build:watch": "tsc --watch",
        "dev": "n8n-node dev",
        "lint": "n8n-node lint",
        "lint:fix": "n8n-node lint --fix",
        "release": "n8n-node release",
        "prepublishOnly": "n8n-node prerelease"
    },
    "files": [
        "dist"
    ],
    "publishConfig": {
        "access": "public"
    },
    "n8n": {
        "n8nNodesApiVersion": 1,
        "strict": true,
        "credentials": [
            "dist/credentials/PdfRedactionApi.credentials.js"
        ],
        "nodes": [
            "dist/nodes/PdfRedaction/PdfRedaction.node.js"
        ]
    },
    "devDependencies": {
        "@n8n/node-cli": "*",
        "eslint": "9.32.0",
        "prettier": "3.6.2",
        "release-it": "^19.0.4",
        "typescript": "5.9.2"
    },
    "peerDependencies": {
        "n8n-workflow": "*"
    }
}
